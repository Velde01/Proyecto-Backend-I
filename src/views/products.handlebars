<div class="container mt-5">
    <h1 class="text-center mb-4">🛒 Catálogo de Productos</h1>
    
    <div class="row">
        {{#each products}}
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{this.title}}</h5>
                        <p class="card-text text-muted">{{this.category}}</p>
                        <p class="card-text flex-grow-1">{{this.description}}</p>
                        <h4 class="text-primary">${{this.price}}</h4>
                        <div class="mt-auto gap-2 d-flex flex-column">
                            <a href="/products/{{this._id}}" class="btn btn-outline-secondary w-100">Ver Detalles</a>
                            <button onclick="addToCart('{{this._id}}')" class="btn btn-success w-100">Agregar al Carrito</button>
                        </div>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>

    <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
        {{#if hasPrevPage}}
            <a href="{{prevLink}}" class="btn btn-primary">⬅ Anterior</a>
        {{else}}
            <button class="btn btn-secondary" disabled>Anterior</button>
        {{/if}}

        <span class="fw-bold">Página {{page}} de {{totalPages}}</span>

        {{#if hasNextPage}}
            <a href="{{nextLink}}" class="btn btn-primary">Siguiente ➡</a>
        {{else}}
            <button class="btn btn-secondary" disabled>Siguiente</button>
        {{/if}}
    </div>
</div>

<script>
    async function addToCart(productId) {
        // ID de carrito quemado de ejemplo para que tu tutor pueda probarlo de forma directa
        // En una app real, el ID se gestiona con sesiones, cookies o localStorage
        const cartId = "6a56c860338e59d877e2fb0b"; 

        try {
            const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
                method: 'POST'
            });
            const data = await response.json();
            
            if (response.ok) {
                alert('¡Producto agregado al carrito con éxito!');
            } else {
                alert('Error al agregar producto: ' + data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Hubo un problema al agregar el producto al carrito.');
        }
    }
</script>